{
  "name": "@visual-regression-tracker/sdk-js",
  "version": "0.0.0-development",
  "description": "JavaScript SDK for Visual Regression Tracker",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "tsc -p tsconfig.spec.json && vitest run",
    "test:cov": "tsc -p tsconfig.spec.json && vitest run --coverage",
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Visual-Regression-Tracker/sdk-js.git"
  },
  "engines": {
    "node": ">=26"
  },
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Visual-Regression-Tracker/sdk-js/issues"
  },
  "homepage": "https://github.com/Visual-Regression-Tracker/Visual-Regression-Tracker",
  "dependencies": {
    "axios": "^1.21.0",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "master",
      {
        "name": "next",
        "prerelease": "rc"
      }
